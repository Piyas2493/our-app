# Copy to .env and fill in from dashboard.bhashini.co.in -> API Keys.
# Names match the dashboard's own field labels exactly:
BHASHINI_USER_ID=       # the "UDYAT KEY" value
BHASHINI_ULCA_API_KEY=  # the "INFERENCE" key value

# Optional: only set this if you have a pipeline ID from your own ULCA
# portal registration. Leave blank to use Bhashini's public default
# ASR+translation+TTS pipeline.
BHASHINI_PIPELINE_ID=

# The Next.js frontend's origin, for CORS. Only change this if the app
# runs on a different port than the default `next dev`.
JEEVA_FRONTEND_ORIGIN=http://localhost:3000

# 1 = synthetic demo patients (default, safe). 0 = the live JeevanLink
# database -- opt in deliberately, never by omission.
JEEVANLINK_DEMO=1
