# Copy to .env for local dev, or set these in Vercel's dashboard
# (Project -> Settings -> Environment Variables) for the deployed app.
# Never commit real values -- this file only documents what's needed.

# --- Database (MongoDB Atlas) ---
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>?retryWrites=true&w=majority
# Get this from Atlas -> Database -> Connect -> Drivers, after creating
# a cluster and a database user. Contains a password -- never paste it
# anywhere but here/your host's env var UI.
DATABASE_URL=

# --- Gemini (document analysis, voice assistant, scribe, etc.) ---
GEMINI_API_KEY=

# --- Vercel Blob (medical document storage) ---
# Vercel dashboard -> your project -> Storage -> Create Database -> Blob.
# Vercel injects this automatically for a deployed project with a Blob
# store attached; for local dev, copy the token from that same Storage
# tab (or run `vercel env pull` if you have the Vercel CLI linked).
BLOB_READ_WRITE_TOKEN=

# --- Jeeva voice service (deployed separately on Render) ---
# The real Render URL once deployed, e.g. https://jeevanlink-jeeva.onrender.com
# NEXT_PUBLIC_ because the browser calls this directly, not just the server.
NEXT_PUBLIC_JEEVA_SERVICE_URL=http://localhost:8000

# --- Handwriting OCR service (deployed separately on Render) ---
# The real Render URL + /handwriting, e.g.
# https://jeevanlink-ocr-service.onrender.com/handwriting
HANDWRITING_OCR_URL=http://localhost:8001/handwriting
