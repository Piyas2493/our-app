// One-time migration helper (2026-09-19): a copy of the schema exactly
// as it was on SQLite, before the MongoDB migration, so this old data
// can be read with proper types (real Date objects, parsed JSON,
// booleans) via Prisma Client instead of hand-rolling SQLite's raw
// on-disk representation of each. A distinct generator `output` and
// datasource env var keep this from colliding with the real (now
// MongoDB) schema/client. Not part of the running app -- delete this
// whole `scripts/mongo-migration/` folder once the migration is done.
generator client {
  provider = "prisma-client-js"
  output   = "./generated-sqlite-legacy-client"
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_LEGACY_URL")
}

enum UserRole {
  PATIENT
  CLINICIAN
  HELPDESK
  ADMIN
}

enum RecordStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ReminderStatus {
  ACTIVE
  DISABLED
}

enum MedicationLogStatus {
  TAKEN
  SKIPPED
  SNOOZED
}

enum VitalType {
  HEART_RATE
  BLOOD_PRESSURE
  OXYGEN_SATURATION
  TEMPERATURE
  WEIGHT
  BLOOD_GLUCOSE
  STEPS
  SLEEP_DURATION
}

enum VitalSource {
  MANUAL
  GOOGLE_HEALTH_CONNECT
  SAMSUNG_HEALTH
  WEARABLE
  FITNESS_APP
}

enum HospitalAdmissionStatus {
  PLANNED
  ADMITTED
  DISCHARGED
  CANCELLED
}

enum HospitalTestStatus {
  ORDERED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum HospitalProcedureStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BillStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum InsuranceClaimStatus {
  NOT_SUBMITTED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  SETTLED
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  PROCESSING
  FINALIZED
  CANCELLED
}

enum LabReportStatus {
  DRAFT
  FINAL
  CORRECTED
  CANCELLED
}

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     UserRole

  patientRecords    MedicalRecord[]     @relation("PatientRecords")
  auditActions      VerificationAudit[] @relation("ClinicianAudits")
  medicationLogs    MedicationLog[]
  vitalMeasurements VitalMeasurement[]

  hospitalAdmissions HospitalAdmission[] @relation("PatientHospitalAdmissions")
  hospitalEncounters HospitalEncounter[] @relation("PatientHospitalEncounters")

  labOrders  LabOrder[]  @relation("PatientLabOrders")
  labReports LabReport[] @relation("PatientLabReports")

  consentEvents ConsentEvent[] @relation("PatientConsentEvents")

  requestedTickets Ticket[]        @relation("TicketRequester")
  assignedTickets  Ticket[]        @relation("TicketAssignee")
  ticketMessages   TicketMessage[] @relation("TicketMessageAuthor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MedicalRecord {
  id String @id @default(cuid())

  patientName    String
  documentName   String
  documentType   String
  interpretation String

  status RecordStatus @default(PENDING)

  originalFileUrl  String?
  originalFileType String?

  // AI-extracted structured lab results (testName/value/unit/referenceRange/
  // status per entry) captured at upload time. Persisted so cross-document
  // abnormal-value tracking on the health timeline survives past the
  // pre-submission review screen, instead of being discarded at submit.
  labResults Json?

  patientId String?

  patient User? @relation("PatientRecords", fields: [patientId], references: [id], onDelete: SetNull)

  medications        Medication[]
  verificationAudits VerificationAudit[]

  labReport LabReport? @relation("LabReportMedicalRecord")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verifiedAt      DateTime?
  rejectionReason String?
}

model Medication {
  id String @id @default(cuid())

  name      String
  dosage    String?
  frequency String?
  duration  String?

  startDate DateTime?
  endDate   DateTime?

  medicalRecordId String

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  reminders MedicationReminder[]

  createdAt DateTime @default(now())
}

model MedicationReminder {
  id String @id @default(cuid())

  medicationId String

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  hour   Int
  minute Int

  status ReminderStatus @default(ACTIVE)

  logs MedicationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MedicationLog {
  id String @id @default(cuid())

  reminderId String

  reminder MedicationReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  actionAt    DateTime?

  status MedicationLogStatus

  snoozedUntil DateTime?

  createdAt DateTime @default(now())

  @@index([userId, scheduledAt])
  @@index([reminderId, scheduledAt])
}

model VerificationAudit {
  id String @id @default(cuid())

  medicalRecordId String

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  clinicianId String?

  clinician User? @relation("ClinicianAudits", fields: [clinicianId], references: [id], onDelete: SetNull)

  action String
  note   String?

  createdAt DateTime @default(now())
}

model VitalMeasurement {
  id String @id @default(cuid())

  patientId String

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  vitalType VitalType

  value          Float?
  secondaryValue Float?
  unit           String

  recordedAt DateTime

  source VitalSource @default(MANUAL)

  deviceName     String?
  sourceRecordId String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, recordedAt])
  @@index([patientId, vitalType, recordedAt])
  @@index([source, recordedAt])
}

model Hospital {
  id String @id @default(cuid())

  name String
  code String? @unique

  address String?
  city    String?
  state   String?
  pincode String?
  phone   String?

  admissions HospitalAdmission[]
  encounters HospitalEncounter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HospitalAdmission {
  id String @id @default(cuid())

  patientId String

  patient User @relation("PatientHospitalAdmissions", fields: [patientId], references: [id], onDelete: Cascade)

  hospitalId String

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  admissionNumber String? @unique

  status HospitalAdmissionStatus @default(ADMITTED)

  admissionDate DateTime
  dischargeDate DateTime?

  ward String?
  bed  String?

  attendingClinicianName String?

  reason           String?
  dischargeSummary String?

  encounters      HospitalEncounter[]
  tests           HospitalTest[]
  procedures      HospitalProcedure[]
  bills           HospitalBill[]
  insuranceClaims InsuranceClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, admissionDate])
  @@index([hospitalId, admissionDate])
}

model HospitalEncounter {
  id String @id @default(cuid())

  admissionId String?

  admission HospitalAdmission? @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  patientId String

  patient User @relation("PatientHospitalEncounters", fields: [patientId], references: [id], onDelete: Cascade)

  encounterType String
  encounterDate DateTime

  clinicianName String?
  department    String?
  notes         String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])
  hospitalId String?

  @@index([patientId, encounterDate])
  @@index([admissionId, encounterDate])
}

model HospitalTest {
  id String @id @default(cuid())

  admissionId String

  admission HospitalAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  name     String
  category String?

  status HospitalTestStatus @default(ORDERED)

  orderedAt   DateTime  @default(now())
  completedAt DateTime?

  resultSummary String?

  reportDocumentUrl  String?
  reportDocumentType String?

  labName String?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([admissionId, orderedAt])
  @@index([status, orderedAt])
}

model HospitalProcedure {
  id String @id @default(cuid())

  admissionId String

  admission HospitalAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  name String

  status HospitalProcedureStatus @default(PLANNED)

  scheduledAt DateTime?
  completedAt DateTime?

  clinicianName String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([admissionId, scheduledAt])
}

model HospitalBill {
  id String @id @default(cuid())

  admissionId String

  admission HospitalAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  invoiceNumber String? @unique

  issuedAt DateTime @default(now())

  status BillStatus @default(ISSUED)

  subtotal               Float @default(0)
  insuranceCoveredAmount Float @default(0)
  patientPayableAmount   Float @default(0)
  totalAmount            Float @default(0)

  currency String @default("INR")

  items           HospitalBillItem[]
  insuranceClaims InsuranceClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([admissionId, issuedAt])
}

model HospitalBillItem {
  id String @id @default(cuid())

  billId String

  bill HospitalBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  description String
  category    String?

  quantity  Float @default(1)
  unitPrice Float @default(0)
  amount    Float @default(0)

  createdAt DateTime @default(now())

  @@index([billId])
}

model InsuranceClaim {
  id String @id @default(cuid())

  admissionId String

  admission HospitalAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  billId String?

  bill HospitalBill? @relation(fields: [billId], references: [id], onDelete: SetNull)

  insurerName String

  policyNumber String?
  claimNumber  String? @unique

  status InsuranceClaimStatus @default(NOT_SUBMITTED)

  submittedAt DateTime?
  decidedAt   DateTime?

  claimedAmount        Float @default(0)
  approvedAmount       Float @default(0)
  rejectedAmount       Float @default(0)
  patientPayableAmount Float @default(0)

  rejectionReason String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([admissionId, createdAt])
  @@index([status, createdAt])
}

model Lab {
  id String @id @default(cuid())

  name String
  code String? @unique

  address String?
  city    String?
  state   String?
  pincode String?
  phone   String?

  orders  LabOrder[]
  reports LabReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LabOrder {
  id String @id @default(cuid())

  patientId String

  patient User @relation("PatientLabOrders", fields: [patientId], references: [id], onDelete: Cascade)

  labId String

  lab Lab @relation(fields: [labId], references: [id], onDelete: Restrict)

  orderNumber String? @unique

  testName     String
  testCategory String?

  status LabOrderStatus @default(ORDERED)

  orderedAt         DateTime  @default(now())
  sampleCollectedAt DateTime?
  finalizedAt       DateTime?

  clinicalNotes String?

  reports LabReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, orderedAt])
  @@index([labId, orderedAt])
  @@index([status, orderedAt])
}

model LabReport {
  id String @id @default(cuid())

  patientId String

  patient User @relation("PatientLabReports", fields: [patientId], references: [id], onDelete: Cascade)

  labId String

  lab Lab @relation(fields: [labId], references: [id], onDelete: Restrict)

  labOrderId String?

  labOrder LabOrder? @relation(fields: [labOrderId], references: [id], onDelete: SetNull)

  medicalRecordId String? @unique

  medicalRecord MedicalRecord? @relation("LabReportMedicalRecord", fields: [medicalRecordId], references: [id], onDelete: SetNull)

  reportNumber String? @unique

  testName     String
  testCategory String?

  status LabReportStatus @default(FINAL)

  resultSummary String?

  reportDate  DateTime
  finalizedAt DateTime?

  sourceRecordId String?

  sourceDocumentUrl  String?
  sourceDocumentType String?

  digitallyReceived Boolean @default(true)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, reportDate])
  @@index([labId, reportDate])
  @@index([status, reportDate])
}

enum ConsentCategory {
  CLINICAL_HISTORY
  DOCUMENT_PROCESSING
  CLINICIAN_SHARING
  RESEARCH_DATA_SHARING
  REMINDERS_NOTIFICATIONS
}

// Append-only consent log. The current status for a category is the
// most recent event for that (patientId, category) pair — never
// mutated in place, so every grant/revoke stays independently
// auditable rather than being overwritten.
model ConsentEvent {
  id String @id @default(cuid())

  patientId String

  patient User @relation("PatientConsentEvents", fields: [patientId], references: [id], onDelete: Cascade)

  category ConsentCategory

  granted Boolean

  source String

  medicalRecordId String?

  notes String?

  createdAt DateTime @default(now())

  @@index([patientId, category, createdAt])
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketCategory {
  ACCOUNT
  APPOINTMENT
  TECHNICAL
  RECORD_CORRECTION
  BILLING
  OTHER
}

model Ticket {
  id String @id @default(cuid())

  ticketNumber String @unique

  requesterId String
  requester   User   @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  subject     String
  description String

  category TicketCategory @default(OTHER)
  priority TicketPriority @default(NORMAL)
  status   TicketStatus   @default(OPEN)

  relatedRecordId String?

  callbackRequested   Boolean   @default(false)
  callbackPhone       String?
  callbackCompletedAt DateTime?

  messages TicketMessage[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  closedAt   DateTime?

  @@index([requesterId, createdAt])
  @@index([assignedToId, status])
  @@index([status, createdAt])
}

model TicketMessage {
  id String @id @default(cuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("TicketMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  body String

  isInternalNote Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}
